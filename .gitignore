# =============================================================================
# Git-ігнор теми MiniStore
# =============================================================================
# Під версійним контролем — ТІЛЬКИ папка теми (див. docs/DECISIONS.md, ADR-007).
# Ядро WordPress, плагіни, wp-content/uploads і база даних сюди не входять.
# =============================================================================

# -- Залежності ---------------------------------------------------------------
# Ставляться командою npm install, у репозиторії не потрібні.
node_modules/

# -- Результат збірки ---------------------------------------------------------
# ⚠ Самі .css МИ КОМІТИМО (ADR-008): на хостингу може не бути Node,
#   і деплой має зводитись до git pull без кроку збірки.
#   А ось карти джерел потрібні лише локально.
*.css.map

# -- Службові файли системи ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -- Логи й локальні змінні -----------------------------------------------------
*.log
.env
.env.local
.env.*.local

# -- Налаштування редакторів ----------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# -- Локальні налаштування інструментів -----------------------------------------
# Накопичений список дозволів Claude Code — специфічний для машини.
.claude/

# -- Тимчасове ------------------------------------------------------------------
*.bak
*.tmp
*~
